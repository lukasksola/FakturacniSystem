<Page x:Class="FakturacniSystem.Pages.Odberatele.UpravitOdberateleView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FakturacniSystem.Pages.Odberatele"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UpravitOdberateleView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="120*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nazev produktu" />
        <TextBox Grid.Column="0" Margin="20" Text="{Binding Nazev,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

        <TextBlock Grid.Column="1" Text="Najit podle ID" />
        <TextBox Grid.Column="1" Margin="30" Text="{Binding Id,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

        <TextBlock Grid.Row="1"  Text="Odebrany pocet" />
        <TextBox Grid.Column="0" Grid.Row="1" Margin="25" Text="{Binding OdebranyPocet, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Nazev Odberatele" />
        <TextBox Grid.Column="1" Grid.Row="1" Margin="25" Text="{Binding NazevOdberatele, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cena Za Kus" />
        <TextBox Grid.Column="0" Grid.Row="2" Margin="25" Text="{Binding CenaZaKus, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Margin="25,60,0,0" Text="" Name="celkovaCena"/>
        <Button Grid.Row="3" Margin="50" Content="Potvrdit a Upravit" FontSize="25" Click="Pridej"/>
        <Button Grid.Row="3" Grid.Column="1" Margin="50" Content="Zrusit" FontSize="25" Click="Zrusit"/>


    </Grid>
</Page>
