<Window x:Class="FakturacniSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FakturacniSystem"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="95*"/>
        </Grid.RowDefinitions>
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" Grid.Row="1"/>

        <Button Grid.Row="0" Width="150" HorizontalAlignment="Left" Content="Sklad" Click="SkladNavigate"/>
        <Button Grid.Row="0" Width="150" HorizontalAlignment="Left" Margin="150,0,0,0" Content="Dodavatele" Click="DodavateleNavigate"/>


    </Grid>
</Window>
